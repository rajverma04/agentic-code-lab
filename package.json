{
  "name": "vocallab",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Intelligent Codebase Analyzer & Developer Assistant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev": "concurrently -k -p \"[{name}]\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build": "npm --prefix packages/shared run build && npm run build:backend && npm run build:frontend",
    "start:backend": "npm --prefix apps/backend run start",
    "start:frontend": "npm --prefix apps/frontend run start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
