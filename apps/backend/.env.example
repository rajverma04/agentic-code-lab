# ==========================================
# Agentic CodeLab — Backend Environment Config Template
# ==========================================

# Server Configuration
PORT=4000
BACKEND_URL="http://localhost:4000"
RENDER_EXTERNAL_URL="http://localhost:4000"

# PostgreSQL Database (Prisma ORM)
# -------------------------------------------------------------------------------------------------
# For Local Docker Compose (npm run docker:up):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/vocallab"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/vocallab"
#
# For Supabase PostgreSQL (Uncomment and replace with your project credentials):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# -------------------------------------------------------------------------------------------------

# Vector Database (Qdrant)
# Defaults to localhost:6333 (started via docker-compose).
# If unreachable, system automatically falls back to in-memory vector store.
QDRANT_URL="http://localhost:6333"

# LLM Providers (Configure at least one)
# 1. Groq Cloud (Free high-speed Qwen 3.6 27B model - Recommended)
GROQ_API_KEY=""

# 2. Alibaba DashScope / Qwen API (Alternative Cloud LLM: qwen-plus)
# Supported variable names: DASHSCOPE_API_KEY, QWEN_API_KEY, or QWEN_API
DASHSCOPE_API_KEY=""

# 3. OpenAI API (gpt-4o-mini & text-embedding-3-small)
OPENAI_API_KEY=""

# 4. Local Ollama (Offline LLM: qwen2.5-coder & nomic-embed-text)
OLLAMA_URL="http://localhost:11434"

# GitHub Integration
# Optional for reading public repos.
# REQUIRED for private repo ingestion and 1-click GitHub Pull Request creation.
GITHUB_TOKEN=""

# Cloned Repositories Storage Directory
REPOS_DIR="./temp_repos"
